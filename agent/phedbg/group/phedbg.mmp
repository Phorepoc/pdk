TARGET          phedbg.exe
TARGETTYPE      exe
UID             0x100039CE 0xE7016B40
SECUREID        0xE7016B40
VENDORID        0
CAPABILITY      ReadUserData WriteUserData NetworkServices LocalServices
EPOCSTACKSIZE   0x5000
EPOCHEAPSIZE    0x10000 0x400000

SOURCEPATH      ../src
SOURCE          phedbg_app.cpp phedbg_server.cpp phedbg_proto.cpp

START RESOURCE  phedbg.rss
HEADER
TARGETPATH      /resource/apps
END
START RESOURCE  phedbg_reg.rss
TARGETPATH      /private/10003a3f/apps
END

USERINCLUDE     ../src
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
MW_LAYER_SYSTEMINCLUDE_SYMBIAN
APP_LAYER_SYSTEMINCLUDE_SYMBIAN

LIBRARY euser.lib apparc.lib cone.lib eikcore.lib eikcoctl.lib eikctl.lib eikdlg.lib avkon.lib
LIBRARY efsrv.lib bafl.lib charconv.lib hal.lib c32.lib esock.lib insock.lib ws32.lib fbscli.lib gdi.lib
