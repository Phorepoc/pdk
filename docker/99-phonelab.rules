# /etc/udev/rules.d/99-phonelab.rules -- the phone's phlink debug port (CDC ACM, VID 0E22 PID 0666):
# a stable name, access for the "dialout" group, and ModemManager told to leave it alone (it probes new ttyACMs
# with AT commands, which the phone would echo into its log or take as phlink commands).
SUBSYSTEM=="tty", ATTRS{idVendor}=="0e22", ATTRS{idProduct}=="0666", SYMLINK+="phorepoc-phlink", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"

# Nokia Symbian^3-family phones in "PC Suite"/"Nokia Suite" USB mode (vendor 0421): the phone exposes several
# CDC ACM functions. One is the phone's own modem/AT port (dial-up), another is free for applications (phedbg opens it
# as RComm "ACM::n"). Both get a stable name per USB interface number, /dev/nokia-acm-<ifnum>, so PhoneLab can be
# pinned to the phedbg one (docs/nokia.md) and never to the modem. ModemManager MUST ignore all of them: it would
# otherwise claim the modem port and probe the others with AT commands.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0421", ENV{ID_MM_DEVICE_IGNORE}="1", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="0421", SYMLINK+="nokia-acm-$env{ID_USB_INTERFACE_NUM}"
